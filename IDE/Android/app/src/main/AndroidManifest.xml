        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        >
        <meta-data android:name="productId" android:value="1679821824" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges=
                "mcc|mnc|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|layoutDirection|fontScale"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
